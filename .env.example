# Database
DATABASE_URL="postgresql://carte:carte_local@localhost:55432/carte?schema=public"

# Redis
REDIS_URL="redis://localhost:56379"

# Auth.js
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth (optional until credentials are configured)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email delivery (optional for local UI; required for real email codes)
RESEND_API_KEY=""
EMAIL_FROM="Carte <noreply@carte.app>"

# Playwright E2E (keep disabled except on an isolated test server)
E2E_TEST_MODE="0"
E2E_TEST_EMAIL_CODE=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (test mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_SINGLE="price_..."
STRIPE_PRICE_ID_LIFETIME="price_..."

# Guest drafts
GUEST_DRAFT_TTL_DAYS="7"
GUEST_DRAFT_CLEANUP_ENABLED="true"
GUEST_DRAFT_CLEANUP_SCHEDULE="0 * * * *"

# Invitation email queue (requires Redis)
EMAIL_QUEUE_ENABLED="false"

# RSVP digest notifications (production defaults to enabled)
RSVP_NOTIFICATION_ENABLED="false"
# Optional test override; production default is one hour (3600000 ms)
RSVP_NOTIFICATION_INTERVAL_MS="3600000"

# AI copy (optional; preset copy is used when unavailable)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
