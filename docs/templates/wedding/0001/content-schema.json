{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carte.local/schemas/wedding-invitation-content-v2.json",
  "title": "Carte Wedding Invitation Content v2",
  "description": "0001 模板的语义化长页面数据。结构与视觉布局解耦，图片和音乐通过 assetId 引用。",
  "type": "object",
  "required": ["document", "navigation", "hero", "story", "gallery", "celebration", "venue", "findUs", "rsvp", "footer", "effects", "music"],
  "properties": {
    "document": {
      "type": "object",
      "required": ["schemaVersion", "pageModel"],
      "properties": {
        "schemaVersion": { "const": "wedding-invitation-content-v2" },
        "pageModel": { "const": "h5-long-scroll" },
        "locale": { "type": "string", "default": "zh-CN" },
        "title": { "type": "string", "maxLength": 120 },
        "metaDescription": { "type": "string", "maxLength": 300 }
      },
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "required": ["brand", "items", "soundControl"],
      "properties": {
        "brand": {
          "type": "object",
          "properties": { "monogram": { "type": "string", "maxLength": 20 }, "separator": { "type": "string", "maxLength": 3 }, "caption": { "type": "string", "maxLength": 40 } },
          "additionalProperties": false
        },
        "items": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/navItem" } },
        "soundControl": { "$ref": "#/$defs/soundControl" }
      },
      "additionalProperties": false
    },
    "hero": {
      "type": "object",
      "required": ["eyebrow", "names", "date", "location", "media"],
      "properties": {
        "eyebrow": { "$ref": "#/$defs/richText" },
        "names": { "$ref": "#/$defs/coupleNames" },
        "date": { "$ref": "#/$defs/eventDate" },
        "location": { "type": "object", "required": ["city", "venue"], "properties": { "city": { "type": "string", "maxLength": 80 }, "venue": { "type": "string", "maxLength": 120 } }, "additionalProperties": false },
        "media": { "$ref": "#/$defs/mediaRef" },
        "overlays": { "type": "object", "properties": { "vignette": { "type": "boolean" }, "glow": { "type": "boolean" }, "imageFilter": { "type": "string" } }, "additionalProperties": false },
        "scrollCue": { "type": "object", "properties": { "label": { "type": "string", "maxLength": 40 }, "targetSectionId": { "type": "string" } }, "additionalProperties": false },
        "sideNote": { "type": "string", "maxLength": 50 }
      },
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "required": ["kicker", "heading", "paragraphs", "signature", "stats"],
      "properties": {
        "kicker": { "$ref": "#/$defs/sectionKicker" },
        "label": { "type": "string", "maxLength": 100 },
        "heading": { "$ref": "#/$defs/richTextLines" },
        "paragraphs": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "maxLength": 600 } },
        "signature": { "type": "object", "properties": { "caption": { "type": "string", "maxLength": 50 }, "names": { "type": "string", "maxLength": 40 } }, "additionalProperties": false },
        "stats": { "type": "array", "minItems": 0, "maxItems": 6, "items": { "$ref": "#/$defs/stat" } }
      },
      "additionalProperties": false
    },
    "gallery": {
      "type": "object",
      "required": ["label", "heading", "album", "secondaryImage"],
      "properties": {
        "label": { "type": "string", "maxLength": 100 },
        "heading": { "$ref": "#/$defs/richTextLines" },
        "indexLabel": { "type": "string", "maxLength": 40 },
        "album": { "$ref": "#/$defs/album" },
        "secondaryImage": { "$ref": "#/$defs/mediaRef" }
      },
      "additionalProperties": false
    },
    "celebration": {
      "type": "object",
      "required": ["kicker", "dateLabel", "heading", "intro", "events"],
      "properties": {
        "kicker": { "$ref": "#/$defs/sectionKicker" },
        "dateLabel": { "type": "string", "maxLength": 100 },
        "heading": { "$ref": "#/$defs/richTextLines" },
        "intro": { "type": "string", "maxLength": 600 },
        "events": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/timelineEvent" } }
      },
      "additionalProperties": false
    },
    "venue": {
      "type": "object",
      "required": ["kicker", "title", "address", "image", "actions", "meta"],
      "properties": {
        "kicker": { "$ref": "#/$defs/sectionKicker" },
        "title": { "$ref": "#/$defs/richTextLines" },
        "address": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "maxLength": 160 } },
        "image": { "$ref": "#/$defs/mediaRef" },
        "photoLabel": { "type": "string", "maxLength": 100 },
        "actions": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/action" } },
        "meta": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/metaItem" } }
      },
      "additionalProperties": false
    },
    "findUs": {
      "type": "object",
      "required": ["kicker", "heading", "description", "map"],
      "properties": {
        "kicker": { "$ref": "#/$defs/sectionKicker" },
        "heading": { "$ref": "#/$defs/richTextLines" },
        "description": { "type": "string", "maxLength": 600 },
        "map": { "$ref": "#/$defs/mapConfig" }
      },
      "additionalProperties": false
    },
    "rsvp": {
      "type": "object",
      "required": ["enabled", "deadline", "heading", "description", "fields", "successMessage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "deadline": { "type": "string", "maxLength": 80 },
        "heading": { "$ref": "#/$defs/richTextLines" },
        "description": { "type": "string", "maxLength": 600 },
        "fields": { "$ref": "#/$defs/rsvpFields" },
        "successMessage": { "type": "string", "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "footer": {
      "type": "object",
      "required": ["items"],
      "properties": { "items": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "maxLength": 100 } } },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "properties": {
        "reveal": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "threshold": { "type": "number", "minimum": 0, "maximum": 1 }, "durationMs": { "type": "integer", "minimum": 0, "maximum": 3000 } }, "additionalProperties": false },
        "particles": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "engine": { "const": "three-points" }, "color": { "type": "string" }, "countMobile": { "type": "integer", "minimum": 0, "maximum": 2000 }, "countDesktop": { "type": "integer", "minimum": 0, "maximum": 3000 }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": false },
        "petals": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "count": { "type": "integer", "minimum": 0, "maximum": 30 }, "color": { "type": "string" }, "durationSeconds": { "type": "number", "minimum": 1, "maximum": 120 } }, "additionalProperties": false },
        "noise": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": false },
        "reducedMotion": { "type": "string", "enum": ["system", "always", "never"] }
      },
      "additionalProperties": false
    },
    "music": {
      "type": "object",
      "required": ["enabled", "source", "userGestureRequired"],
      "properties": {
        "enabled": { "type": "boolean" },
        "source": { "type": "string", "enum": ["asset-library", "web-audio-sequence", "none"] },
        "assetId": { "type": ["string", "null"] },
        "fallback": { "type": ["object", "null"], "properties": { "engine": { "const": "web-audio" }, "notesHz": { "type": "array", "items": { "type": "number" } }, "noteSpacingMs": { "type": "integer", "minimum": 1 }, "oscillator": { "type": "string" } }, "additionalProperties": false },
        "userGestureRequired": { "const": true },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "richText": { "type": "object", "required": ["segments"], "properties": { "segments": { "type": "array", "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string", "maxLength": 200 }, "emphasis": { "type": "boolean" } }, "additionalProperties": false } } }, "additionalProperties": false },
    "richTextLines": { "type": "object", "required": ["lines"], "properties": { "lines": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/richText" } } }, "additionalProperties": false },
    "coupleNames": { "type": "object", "required": ["partnerA", "partnerB", "separator"], "properties": { "partnerA": { "type": "string", "maxLength": 50 }, "partnerB": { "type": "string", "maxLength": 50 }, "separator": { "type": "string", "maxLength": 5 } }, "additionalProperties": false },
    "eventDate": { "type": "object", "required": ["value", "display"], "properties": { "value": { "type": "string", "format": "date" }, "display": { "type": "string", "maxLength": 100 }, "displayLocale": { "type": "string" } }, "additionalProperties": false },
    "mediaRef": { "type": "object", "required": ["assetId", "fit"], "properties": { "assetId": { "type": ["string", "null"] }, "url": { "type": ["string", "null"] }, "alt": { "type": "string", "maxLength": 200 }, "fit": { "type": "string", "enum": ["cover", "contain", "fill"] }, "position": { "type": "string", "maxLength": 40 } }, "additionalProperties": false },
    "sectionKicker": { "type": "object", "required": ["number", "label"], "properties": { "number": { "type": "string", "maxLength": 5 }, "label": { "type": "string", "maxLength": 50 } }, "additionalProperties": false },
    "stat": { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": "string", "maxLength": 30 }, "label": { "type": "string", "maxLength": 60 } }, "additionalProperties": false },
    "album": { "type": "object", "required": ["items", "autoplay", "intervalMs", "controls"], "properties": { "items": { "type": "array", "minItems": 1, "maxItems": 9, "items": { "type": "object", "required": ["id", "media", "caption"], "properties": { "id": { "type": "string" }, "media": { "$ref": "#/$defs/mediaRef" }, "caption": { "type": "string", "maxLength": 80 } }, "additionalProperties": false } }, "autoplay": { "type": "boolean" }, "intervalMs": { "type": "integer", "minimum": 1000, "maximum": 60000 }, "controls": { "type": "object", "properties": { "arrows": { "type": "boolean" }, "dots": { "type": "boolean" }, "keyboard": { "type": "boolean" }, "touch": { "type": "boolean" } }, "additionalProperties": false } }, "additionalProperties": false },
    "timelineEvent": { "type": "object", "required": ["id", "time", "label", "title", "description"], "properties": { "id": { "type": "string" }, "time": { "type": "string", "maxLength": 20 }, "label": { "type": "string", "maxLength": 30 }, "title": { "type": "string", "maxLength": 80 }, "description": { "type": "string", "maxLength": 400 } }, "additionalProperties": false },
    "action": { "type": "object", "required": ["id", "label", "kind", "href"], "properties": { "id": { "type": "string" }, "label": { "type": "string", "maxLength": 40 }, "kind": { "type": "string", "enum": ["navigation", "map", "external"] }, "href": { "type": "string", "maxLength": 500 }, "icon": { "type": "string", "maxLength": 40 }, "target": { "type": "string", "enum": ["same", "new"] } }, "additionalProperties": false },
    "metaItem": { "type": "object", "required": ["icon", "text"], "properties": { "icon": { "type": "string", "maxLength": 40 }, "text": { "type": "string", "maxLength": 120 } }, "additionalProperties": false },
    "mapConfig": { "type": "object", "required": ["latitude", "longitude"], "properties": { "provider": { "type": "string", "enum": ["openstreetmap", "amap", "google", "custom"] }, "embedUrl": { "type": "string", "maxLength": 1000 }, "externalUrl": { "type": "string", "maxLength": 1000 }, "latitude": { "type": "number", "minimum": -90, "maximum": 90 }, "longitude": { "type": "number", "minimum": -180, "maximum": 180 }, "bbox": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } }, "markerLabel": { "type": "string", "maxLength": 120 }, "providers": { "type": "object", "properties": { "zh-CN": { "type": "object" }, "default": { "type": "object" } }, "additionalProperties": true } }, "additionalProperties": false },
    "soundControl": { "type": "object", "properties": { "label": { "type": "string", "maxLength": 20 }, "playLabel": { "type": "string", "maxLength": 40 }, "stopLabel": { "type": "string", "maxLength": 40 } }, "additionalProperties": false },
    "rsvpFields": { "type": "object", "required": ["name", "guests", "attending", "message"], "properties": { "name": { "$ref": "#/$defs/formField" }, "guests": { "type": "object", "properties": { "label": { "type": "string" }, "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 }, "default": { "type": "integer", "minimum": 1 } }, "additionalProperties": false }, "attending": { "type": "object", "properties": { "label": { "type": "string" }, "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": "string" }, "label": { "type": "string" } }, "additionalProperties": false } } }, "additionalProperties": false }, "message": { "$ref": "#/$defs/formField" }, "submitLabel": { "type": "string", "maxLength": 40 } }, "additionalProperties": false },
    "formField": { "type": "object", "properties": { "label": { "type": "string", "maxLength": 60 }, "placeholder": { "type": "string", "maxLength": 120 }, "required": { "type": "boolean" } }, "additionalProperties": false },
    "navItem": { "type": "object", "required": ["id", "label", "targetSectionId"], "properties": { "id": { "type": "string" }, "label": { "type": "string", "maxLength": 30 }, "targetSectionId": { "type": "string" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
