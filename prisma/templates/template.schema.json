{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Carte Template",
  "type": "object",
  "required": ["id", "name", "scene", "style", "tags", "thumbnailUrl", "previewUrl", "canvas", "layers", "variables", "colorSchemes", "settings"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "scene": { "enum": ["wedding", "birthday", "business", "baby", "other"] },
    "style": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "thumbnailUrl": { "type": "string", "minLength": 1 },
    "previewUrl": { "type": "string", "minLength": 1 },
    "pageModel": { "type": "string", "enum": ["canvas", "h5-long-scroll"] },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "background": { "type": "object" }
      },
      "additionalProperties": false
    },
    "layers": { "type": "array", "items": { "type": "object" } },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "data"],
        "properties": { "id": { "type": "string" }, "type": { "type": "string" }, "name": { "type": "string" }, "visible": { "type": "boolean" }, "locked": { "type": "boolean" }, "data": { "type": "object" } },
        "additionalProperties": true
      }
    },
    "assets": { "type": "array", "items": { "type": "object" } },
    "variables": { "type": "array", "items": { "type": "object" } },
    "colorSchemes": { "type": "array", "items": { "type": "object" }, "minItems": 1 },
    "editorSchema": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "const": 1 },
        "sectionTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["fields"],
            "properties": {
              "label": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }] },
              "icon": { "type": "string" },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "label"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "label": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }] },
                    "tab": { "enum": ["content", "media", "style", "behavior"] },
                    "kind": { "enum": ["text", "textarea", "number", "boolean", "select", "color", "date", "url", "media", "image-list", "object-list", "readonly", "hint"] },
                    "description": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }] },
                    "placeholder": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }] },
                    "defaultValue": {},
                    "options": { "type": "array", "items": { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": "string" }, "label": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }] } }, "additionalProperties": false } },
                    "itemLabel": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }] },
                    "itemFields": { "type": "array", "items": { "$ref": "#/properties/editorSchema/properties/sectionTypes/additionalProperties/properties/fields/items" } },
                    "maxItems": { "type": "integer", "minimum": 0 },
                    "minItems": { "type": "integer", "minimum": 0 },
                    "multiline": { "type": "boolean" },
                    "uploadPath": { "type": "string" },
                    "accept": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "sectionPresets": { "type": "array", "items": { "type": "object", "required": ["type", "label", "data"], "properties": { "type": { "type": "string" }, "label": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }] }, "data": { "type": "object" } }, "additionalProperties": false } }
      },
      "additionalProperties": false
    },
    "settings": { "type": "object" },
    "music": { "type": "object" }
  },
  "additionalProperties": false
}
