{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Carte Template",
  "type": "object",
  "required": ["id", "name", "scene", "style", "tags", "thumbnailUrl", "previewUrl", "canvas", "layers", "variables", "colorSchemes", "settings"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "scene": { "enum": ["wedding", "birthday", "business", "baby", "other"] },
    "style": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "thumbnailUrl": { "type": "string", "minLength": 1 },
    "previewUrl": { "type": "string", "minLength": 1 },
    "pageModel": { "type": "string", "enum": ["canvas", "h5-long-scroll"] },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "background": { "type": "object" }
      },
      "additionalProperties": false
    },
    "layers": { "type": "array", "items": { "type": "object" } },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "data"],
        "properties": { "id": { "type": "string" }, "type": { "type": "string" }, "name": { "type": "string" }, "visible": { "type": "boolean" }, "locked": { "type": "boolean" }, "data": { "type": "object" } },
        "additionalProperties": true
      }
    },
    "assets": { "type": "array", "items": { "type": "object" } },
    "variables": { "type": "array", "items": { "type": "object" } },
    "colorSchemes": { "type": "array", "items": { "type": "object" }, "minItems": 1 },
    "settings": { "type": "object" },
    "music": { "type": "object" }
  },
  "additionalProperties": false
}
